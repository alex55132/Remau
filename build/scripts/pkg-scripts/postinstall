#!/bin/sh

# PKG Postinstall Script
# This script installs BlackHole audio driver if needed
# Note: Running in sandbox, so we can only use system logger, not file writes

# Log to system log only (sandbox-compatible)
log_message() {
    logger -t "remau-postinstall" "$1" 2>/dev/null || echo "$1" >&2
}

log_message "=== Remau Postinstall Started at $(date) ==="

# Get the logged-in user (not root)
get_logged_in_user() {
    # Try multiple methods to get the logged-in user
    local user=$(who | grep "console" | awk '{print $1}' | head -n 1)
    if [ -z "$user" ]; then
        user=$(stat -f '%Su' /dev/console 2>/dev/null || echo "")
    fi
    if [ -z "$user" ] || [ "$user" = "root" ]; then
        # Fallback: get the first non-root user with a home directory
        user=$(dscl . -list /Users | grep -v "^_" | grep -v "^root" | head -n 1)
    fi
    echo "$user"
}

USER=$(get_logged_in_user)
log_message "Detected user: $USER"

if [ -z "$USER" ] || [ "$USER" = "root" ]; then
    log_message "Warning: Could not determine logged-in user. Skipping BlackHole installation."
    exit 0  # Don't fail the installation
fi

# Execute BlackHole installation as the logged-in user
# Using bash here because we need bash features (arrays, etc)
su - "$USER" -c 'bash -c "
# macOS BlackHole Installation Script
# This script checks if BlackHole is installed and installs it using Homebrew

set -e

# Function to find Homebrew installation
find_homebrew() {
    # Common Homebrew installation paths
    local brew_paths=(
        \"/opt/homebrew/bin/brew\"      # Apple Silicon (M1/M2+)
        \"/usr/local/bin/brew\"         # Intel Macs
        \"$HOME/.homebrew/bin/brew\"    # Custom user install
    )
    
    # Check common paths first
    for path in \"\${brew_paths[@]}\"; do
        if [ -f \"\$path\" ] && [ -x \"\$path\" ]; then
            echo \"\$path\"
            return 0
        fi
    done
    
    # Fallback: check if brew is in PATH
    if command -v brew &> /dev/null; then
        command -v brew
        return 0
    fi
    
    return 1
}

# Function to check if Homebrew is installed
check_homebrew_installed() {
    local brew_path=\$(find_homebrew)
    if [ -n \"\$brew_path\" ]; then
        return 0  # Installed
    else
        return 1  # Not installed
    fi
}

# Function to check if BlackHole is installed
check_blackhole_installed() {
    # Check if BlackHole appears in system_profiler output
    if system_profiler SPAudioDataType 2>/dev/null | grep -q \"BlackHole\"; then
        return 0  # Installed
    else
        return 1  # Not installed
    fi
}

# Function to check and warn about Homebrew
check_homebrew_required() {
    logger -t \"remau-postinstall\" \"Warning: Homebrew is not installed.\" 2>/dev/null || true
    logger -t \"remau-postinstall\" \"This application requires Homebrew to install BlackHole.\" 2>/dev/null || true
    logger -t \"remau-postinstall\" \"Please install Homebrew from https://brew.sh and try again.\" 2>/dev/null || true
    return 1
}

# Main installation function
install_blackhole() {
    local brew_path=\$(find_homebrew)
    
    if [ -z \"\$brew_path\" ]; then
        logger -t \"remau-postinstall\" \"Could not find Homebrew installation.\" 2>/dev/null || true
        return 1
    fi
    
    logger -t \"remau-postinstall\" \"Installing BlackHole 2ch via Homebrew...\" 2>/dev/null || true
    
    # Execute brew install with the found path
    # Source common shell profiles to ensure environment is set up
    if [ -f \"\$HOME/.zprofile\" ]; then
        source \"\$HOME/.zprofile\" 2>/dev/null || true
    elif [ -f \"\$HOME/.bash_profile\" ]; then
        source \"\$HOME/.bash_profile\" 2>/dev/null || true
    elif [ -f \"\$HOME/.profile\" ]; then
        source \"\$HOME/.profile\" 2>/dev/null || true
    fi
    
    # Run brew install
    if \"\$brew_path\" install --cask blackhole-2ch 2>&1; then
        logger -t \"remau-postinstall\" \"BlackHole 2ch installed successfully!\" 2>/dev/null || true
        logger -t \"remau-postinstall\" \"Note: You may need to restart your Mac for the audio device to appear.\" 2>/dev/null || true
        return 0
    else
        logger -t \"remau-postinstall\" \"Failed to install BlackHole 2ch.\" 2>/dev/null || true
        return 1
    fi
}

# Main execution
main() {
    logger -t \"remau-postinstall\" \"Checking for BlackHole installation...\" 2>/dev/null || true
    
    # Check if already installed
    if check_blackhole_installed; then
        logger -t \"remau-postinstall\" \"BlackHole is already installed.\" 2>/dev/null || true
        return 0
    fi
    
    logger -t \"remau-postinstall\" \"BlackHole not found. Attempting to install...\" 2>/dev/null || true
    
    # Check if Homebrew is installed
    if ! check_homebrew_installed; then
        check_homebrew_required
        return 1
    fi
    
    # Install BlackHole
    if install_blackhole; then
        return 0
    else
        return 1
    fi
}

# Run main function
main \"\$@\"
"' 2>&1 || {
    EXIT_CODE=$?
    log_message "Warning: BlackHole installation script exited with code $EXIT_CODE, but continuing installation."
}

log_message "=== Remau Postinstall Completed at $(date) ==="

exit 0
